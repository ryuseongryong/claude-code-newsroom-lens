# ── 비밀 ─────────────────────────────────────────────────────────────────────
# X-Origin-Verify 공유 비밀. CloudFront 와 ALB 가 이 값으로 서로를 확인하므로
# 저장소에 들어가면 오리진 보호의 두 번째 겹이 무력화된다.
.origin-verify
.env
.env.*
*.pem

# ── 파이썬 ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ── 노드 / CDK ───────────────────────────────────────────────────────────────
node_modules/
cdk.out/
cdk.context.json
*.d.ts
*.tsbuildinfo

# ── 로컬 작업물 ──────────────────────────────────────────────────────────────
.remember/
tools/shots/

# 이 저장소가 만든 것이 아닌 로컬 도구 정의
.claude/
